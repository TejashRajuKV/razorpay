# ─────────────────────────────────────────────────────────────
# AI Revenue Recovery Agent — Environment Variables Template
# Copy to .env and fill in values before starting the servers.
# ─────────────────────────────────────────────────────────────

# ── Node.js Backend ──────────────────────────────────────────
NODE_ENV=development
PORT=3001
API_VERSION=v1

# ── CORS ─────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── Database (SQLite by default; switch to postgres for prod) ─
DB_TYPE=sqlite
# DB_PATH is relative to backend/; defaults to backend/data/revenue_recovery.db
# DB_PATH=./data/revenue_recovery.db

# PostgreSQL (uncomment if DB_TYPE=postgres)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=revenue_recovery
# DB_USER=recovery_user
# DB_PASSWORD=your_password

# ── Python ML Service ─────────────────────────────────────────
ML_SERVICE_URL=http://localhost:5001
ML_PORT=5001
ML_SERVICE_TIMEOUT=5000

# ── Recovery Safety Bounds ────────────────────────────────────
MAX_RETRY_ATTEMPTS=3
RETRY_COOLDOWN_MINUTES=60
MAX_RECOVERY_ATTEMPTS=5
HIGH_VALUE_THRESHOLD=50000
LOW_CONFIDENCE_THRESHOLD=0.40

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200
